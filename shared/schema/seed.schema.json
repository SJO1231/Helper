{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed",
  "$defs": {
    "stage": { "enum": ["receipt", "bid", "contract", null] },
    "flag": { "enum": [0, 1] },
    "dict_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["std_key", "module", "stages", "type", "label", "as_column", "index", "derived", "display"],
      "properties": {
        "std_key": { "type": "string", "minLength": 1 },
        "module": { "type": "string" },
        "stages": { "type": "array", "items": { "type": "string" } },
        "type": { "enum": ["text", "number", "money", "percent", "date", "datetime", "bool", "code"] },
        "label": { "type": "string" },
        "as_column": { "$ref": "#/$defs/flag" },
        "index": { "$ref": "#/$defs/flag" },
        "derived": { "$ref": "#/$defs/flag" },
        "display": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["data_map", "pclm", "v4.1", "ours"] }
            }
          }
        }
      }
    },
    "dict_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "screen_code", "source_key", "std_key"],
      "properties": {
        "site": { "type": "string" },
        "screen_code": { "type": ["string", "null"] },
        "source_key": { "type": "string", "minLength": 1 },
        "std_key": { "type": "string", "minLength": 1 }
      }
    },
    "dict_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "scope_id", "key", "label"],
      "properties": {
        "scope": { "enum": ["user", "screen", "site", "system"] },
        "scope_id": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      }
    },
    "dict_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["std_key", "code", "meaning", "scope"],
      "properties": {
        "std_key": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "meaning": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "dict_child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "table_code", "alias", "stage", "typed", "key_fields"],
      "properties": {
        "site": { "type": "string" },
        "table_code": { "type": "string", "minLength": 1 },
        "alias": { "type": "string" },
        "stage": { "$ref": "#/$defs/stage" },
        "typed": { "$ref": "#/$defs/flag" },
        "key_fields": { "type": "array", "items": { "type": "string" }, "maxItems": 2 }
      }
    },
    "dict_screen": { "$ref": "dict-screen" },
    "file_dict_key": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_key" } } }
    },
    "file_dict_alias": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_alias" } } }
    },
    "file_dict_label": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_label" } } }
    },
    "file_dict_code": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_code" } } }
    },
    "file_dict_child": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_child" } } }
    },
    "file_dict_screen": {
      "$ref": "#/$defs/file",
      "properties": { "rows": { "items": { "$ref": "#/$defs/dict_screen" } } }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": { "rows": { "type": "array" } }
    }
  }
}
